#PBS -N a9
#PBS -l nodes=1:ppn=8,walltime=2400:00:00
#PBS -V
#PBS -o tmp.out
#PBS -e tmp.err

cd $PBS_O_WORKDIR

DO=../bin/etrans.MPI

FN_IN=a9.txt
FN_OUT=$PBS_JOBNAME

OPTS=' -N 1250 -T 300 -Q 2 -p parm.txt
 -h 0.2 -O outsh.txt -w a9_t600.dat '


mpiexec.openmpi ${DO} -s ${FN_IN} ${OPTS} -l ${FN_OUT}.log ${FN_OUT}.dat
